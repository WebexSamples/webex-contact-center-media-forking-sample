# Copy to .env and replace all values with the configuration for your test organization.
# JWS_ISSUERS must be a comma-separated allowlist from trusted Webex tenant documentation.
# Do not discover or trust issuers from an incoming, unverified token.
JWS_ISSUERS=https://your-webex-identity-broker.example/idb
JWS_AUDIENCE=your-registered-audience
JWS_SUBJECT=your-registered-subject
CUSTOMER_ORG_ID=your-customer-organization-uuid
MEDIA_FORKING_SCHEMA_ID=your-media-forking-schema-uuid
DATASOURCE_URL=https://media.example.com:8443
TLS_CERT_FILE=./certs/fullchain.pem
TLS_KEY_FILE=./certs/privkey.pem
PORT=8443
# Optional: enable separate caller/agent WAV files in a private directory (0700).
# Leave unset to keep recording disabled. Use a writable persistent path on a hosted receiver.
# RECORDING_DIR=./recordings
